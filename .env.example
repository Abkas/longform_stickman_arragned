# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored — never commit real keys.

# Required only for the automated Gemini API visual-generation path
# (system/05_visuals/generate_visuals.py, generate_character_reference.py).
# Not required for the manual Flow/browser-extension path — see
# system/04_shots/shot.md's "Generating the shots: the free path" section.
# Get one at https://ai.google.dev (Google AI Studio) — billed, no free tier
# for image/video generation on this API.
GEMINI_API_KEY=

# Required for system/06_voice/voice_generate.py (automated narration via
# ElevenLabs' timestamped TTS API). Get one at elevenlabs.io -> Profile ->
# API Keys -> create a new key with these permissions (least-privilege,
# not "all"):
#   - Text to Speech: Read + Write (the actual narration generation)
#   - Voices: Read (to look up the locked video-001/voice.md voice by
#     name, and confirm it exists, before spending credits on it)
#   - (optional but useful) User: Read -- lets voice_generate.py check
#     remaining character quota before a long run instead of finding out
#     mid-generation
# A key scoped to ONLY "Text to Speech" still works for generation, but
# voice_generate.py won't be able to auto-resolve the voice by name (only
# by a --voice-id you paste in directly).
ELEVENLABS_API_KEY=
