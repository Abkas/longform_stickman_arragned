.claude/settings.local.json

# OS/editor cruft
.DS_Store
Thumbs.db

# credentials — never commit these
.env
*.token
credentials.json
token.json
client_secret*.json

# Python cruft
__pycache__/
*.pyc
pipeline/.venv/

# generated/rendered video-production media — large binaries, never posted
# to GitHub. Scoped to videos/ specifically (not a blanket *.jpg/*.png rule)
# so the small, legitimate reference images under assets/references/images/
# and any future assets/character/ reference image stay tracked.
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*.png
videos/**/*.gif
videos/**/*.webp
videos/**/*.mp4
videos/**/*.mov
videos/**/*.webm
videos/**/*.mp3
videos/**/*.wav
videos/*.zip
