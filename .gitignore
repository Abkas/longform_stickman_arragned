.claude/settings.local.json

# OS/editor cruft
.DS_Store
Thumbs.db

# credentials — never commit these
.env
*.token
credentials.json
token.json
client_secret*.json

# persistent browser profile(s) for the Flow automation driver — each
# holds a real logged-in Google session (cookies), never commit. Default
# single-account profile plus any named multi-account profiles created via
# `flow_record_session.py --account <name>`.
system/05_visuals/.flow_profile/
system/05_visuals/.flow_profile_*/

# per-account Flow project URLs (default= plus acc2=, acc3=, ... -- see
# flow_record_session.py's --account flag for how each profile gets
# created). Not secret like the profiles above, but project URLs are
# account-identifying, and this stays local so it survives across
# sessions instead of getting re-discovered from shell history each time.
system/05_visuals/accounts.local.md

# Python cruft
__pycache__/
*.pyc
system/05_visuals/.venv/

# generated/rendered video-production media — large binaries, never posted
# to GitHub. Scoped to videos/ specifically (not a blanket *.jpg/*.png rule)
# so the small, legitimate reference images under system/shared/references/images/
# and system/05_visuals/character_reference/ stay tracked.
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*.png
videos/**/*.gif
videos/**/*.webp
videos/**/*.mp4
videos/**/*.mov
videos/**/*.webm
videos/**/*.mp3
videos/**/*.mpeg
videos/**/*.m4a
videos/**/*.wav
videos/*.zip

# build intermediates (assemble.py) — disposable, safe to delete/re-render,
# and the concat-list file inside it holds machine-specific absolute paths
videos/**/render_clips/

# chunk-completion markers (run_full_batch.py's chunked verify/promote
# pipeline) -- local pipeline state only, meaningless without the actual
# chunk images (already excluded above as large binaries)
videos/**/.verified

# structured per-shot event log (flow_batch_driver.py's EventLog) -- same
# kind of local debugging record as system/05_visuals/logs/ above, grows
# unbounded, not source
videos/**/batch_events.jsonl

# flow_batch_driver.py's failure-diagnosis screenshots — grows unbounded
# on every run, purely for local debugging, never posted to GitHub
system/05_visuals/.flow_debug/

# full terminal-output logs of driver runs — local debugging record only
system/05_visuals/logs/

# per-account quota-cooldown state, persisted so it survives across the
# short-lived processes the systemd timer spawns — local runtime state,
# not something to commit
system/05_visuals/.flow_quota_cooldowns.json
